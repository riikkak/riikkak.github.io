<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="author" content="Riikka Koskenranta">
<meta name="description" content="{{ page.description | default: site.description | escape }}">

<title>
    {% unless page.title == "Riikka Koskenranta" %}
    {{ page.title }}{% if page.course %} - {{ page.course | upcase }}{% endif %} &middot;
    {% endunless %}
    Riikka Koskenranta
</title>

<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400..500&family=Public+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap">
<link rel="stylesheet" href="/dist/css/styles.min.css">

{% comment %} Sets page_nav and page_courses for course pages. header.liquid reads page_courses; the layouts pass page_nav to navigation.liquid. {% endcomment %}
{% if page.course %}
    {% include course-variables.liquid %}
{% endif %}
