<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="author" content="Riikka Koskenranta">
<meta name="description" content="{{ page.description | default: site.description | escape }}">

<title>
    {% unless page.title == "Riikka Koskenranta" %}
    {{ page.title }}{% if page.course %} - {{ page.course | upcase }}{% endif %} &middot;
    {% endunless %}
    Riikka Koskenranta
</title>

{% comment %} Every page uses these two fonts. Preloading them fetches them alongside the stylesheet instead of after it, so text doesn't first show in the fallback font. styles/main.less has the @font-face rules. {% endcomment %}
<link rel="preload" href="/dist/fonts/public-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/dist/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/dist/css/styles.min.css">

{% comment %} Sets page_nav and page_courses for course pages. header.liquid reads page_courses; the layouts pass page_nav to navigation.liquid. {% endcomment %}
{% if page.course %}
    {% include course-variables.liquid %}
{% endif %}
